DB_HOST=localhost
DB_NAME=wisata_jakarta
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
CORS_ALLOW_ORIGINS=https://wisatajakartaai.com,https://www.wisatajakartaai.com

# Google Maps Geocoding / Places API (untuk koordinat 100% selaras Google Maps)
# GOOGLE_MAPS_API_KEY=your_api_key_here

# Guardrail kualitas query search (backend, authoritative)
# - tolak query terlalu pendek/acak
# - hanya lanjutkan hasil semantic dengan confidence minimum
SEARCH_MIN_QUERY_CHARS=5
SEARCH_MIN_QUERY_ALPHA_RATIO=0.55
SEARCH_MIN_SEMANTIC_SCORE=0.2
SEARCH_MIN_CONFIDENT_RESULTS=3
SEARCH_MIN_TOURISM_EMBEDDING_SIM=0.32

# Auth admin — Google OAuth (Client ID OAuth 2.0 Web dari Google Cloud Console)
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Auth admin — reset password via email
# APP_PUBLIC_BASE_URL=https://wisatajakartaai.com
# ADMIN_LOGIN_GATE_PATH=/WJAI_SUPER_SECRET_GATE
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Wisata Jakarta AI <your@gmail.com>
# PASSWORD_RESET_EXPIRY_HOURS=1
# AUTH_DEBUG_RESET=true

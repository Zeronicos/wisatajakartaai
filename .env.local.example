# Dev lokal:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_API_RELATIVE_PROXY=true
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000
#
# Production Vercel (hindari CORS — browser fetch same-origin, Next rewrite ke VPS):
# NEXT_PUBLIC_API_BASE_URL=https://api.wisatajakartaai.com/api
# NEXT_PUBLIC_API_RELATIVE_PROXY=true
# BACKEND_INTERNAL_URL=https://api.wisatajakartaai.com
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=false
NEXT_PUBLIC_REQUIRE_LIVE_EDA=false

# Guardrail kualitas query (frontend pre-check; backend tetap menjadi otoritas utama)
NEXT_PUBLIC_SEARCH_MIN_QUERY_CHARS=5
NEXT_PUBLIC_SEARCH_MIN_QUERY_ALPHA_RATIO=0.55

WJAI_ADMIN_SECRET_PATH=/WJAI_SUPER_SECRET_GATE

# Google Sign-In admin (OAuth 2.0 Client ID — Web application)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

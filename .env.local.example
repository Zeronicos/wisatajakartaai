# Di development, default fetch langsung ke backend lokal:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
# Anda boleh mengisi baris ini secara eksplisit bila ingin mengunci target API.
#
# Paksa proxy same-origin /__wisata_api (hanya dev, opsional):
# NEXT_PUBLIC_API_RELATIVE_PROXY=true
#
# Target rewrite server-side (Docker: http://host.docker.internal:8000):
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Pipeline clustering: balik ke mock kalau error (lihat runFullPipeline).
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=false

# Halaman EDA: kalau backend tidak jalan, default pakai MOCK_EDA + banner (tanpa uncaught error).
# Set true hanya jika Anda memang ingin error keras bila /api/eda gagal.
NEXT_PUBLIC_REQUIRE_LIVE_EDA=false

# Jalur rahasia untuk halaman login/register admin (hanya Middleware Next.js, bukan NEXT_PUBLIC).
# Kosongkan = default di kode tetap `/WJAI_SUPER_SECRET_GATE`; produksi pakai path acak sulit tebak (restart Next setelah ubah).
WJAI_ADMIN_SECRET_PATH=/WJAI_SUPER_SECRET_GATE

[Unit]
Description=WJAI Backend
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/app/backend
EnvironmentFile=/var/www/app/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/app/backend/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/www/app/backend

[Install]
WantedBy=multi-user.target